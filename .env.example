# Public connection details printed by `npm run supabase:start`.
# These local placeholders are intentionally non-sensitive. Replace them with the
# matching project values in deployment environments; never expose the service-role key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
